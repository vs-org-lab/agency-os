# Copy to .env.local and fill in. .env.local is ignored by git.

# Database (Supabase Agency-OS-Dev). URL-encode special characters in the password.
# Transaction pooler, used by the application.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Session pooler, used by migrations and database tests.
DATABASE_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Supabase API (Project Settings → API Keys). Use `supabase projects api-keys --reveal` for the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ACTIVITY_SECRET=

# Inngest. INNGEST_DEV=1 uses the local Inngest Dev Server instead of the cloud keys.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry (EU region). Empty DSN disables Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# End-to-end tests against a protected Vercel deployment.
VERCEL_AUTOMATION_BYPASS_SECRET=
E2E_BASE_URL=http://localhost:3000

# Commercial module: public links, the organization that receives applications and the base URL for emailed links.
PUBLIC_LINK_SECRET=
PUBLIC_ORGANIZATION_SLUG=
APP_BASE_URL=http://localhost:3000
# Origins allowed to embed the application form, comma separated.
APPLY_EMBED_ORIGINS=

# Application email: capture (stored for tests) or smtp.
EMAIL_TRANSPORT=capture
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Calendar used by the discovery call booking: fake or google.
CALENDAR_PROVIDER=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
