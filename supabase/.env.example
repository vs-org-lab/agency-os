# Values substituted into supabase/config.toml by the Supabase CLI.
AUTH_SITE_URL=http://localhost:3000
AUTH_REDIRECT_URLS=http://localhost:3000/**
# Development project only: Vercel preview deployments. Elsewhere repeat AUTH_REDIRECT_URLS.
AUTH_PREVIEW_REDIRECT_URLS=https://*-vs-lab1.vercel.app/**
SMTP_HOST=smtp.gmail.com
SMTP_SENDER_NAME=Agency OS
# SMTP_USER and SMTP_PASSWORD come from the shell environment (.env.local or CI secrets).
